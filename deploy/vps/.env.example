# Kopieer dit bestand naar .env en vul het in.

# Het adres waarop je kobosync wilt bereiken, zonder https://
# Dit domein moet met een A-record naar het IP-adres van je server wijzen.
DOMAIN=kobo.jouwdomein.nl

# Een lang geheim van eigen keuze. Maak er een met:  openssl rand -hex 16
KOBOSYNC_TOKEN=

LIBRARY_DIR=./library
DATA_DIR=./data

# Verbeteringen aan je boeken. Haal het hekje weg en zet op false om uit te zetten.
# KOBOSYNC_SPLIT_AUTHORS=true
# KOBOSYNC_FOLDER_COLLECTIONS=true
# KOBOSYNC_FIX_STYLES=true
# KOBOSYNC_MOVE_FRONT_MATTER=true
